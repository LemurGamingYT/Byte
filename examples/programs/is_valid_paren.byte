fn is_valid(string s) -> bool {
    mut num_paren = 0
    for i in 0..s.length {
        char = s.get(i)
        if char == "(" {
            num_paren += 1
        } else if char == ")" {
            num_paren -= 1
        }
    }

    return num_paren == 0
}

fn main() -> int {
    print(is_valid("(()"))
    return 0
}
