class Engine {
    float horsepower
}

class Car {
    Engine& engine
    int fuel

    fn drive(Car self) {
        print("Driving car with horsepower " + self.engine.horsepower.to_string() + " and fuel " + self.fuel.to_string())
    }
}


fn main() -> int {
    engine = new Engine(450.0)
    car = new Car(engine, 100)
    car.drive()
    return 0
}
