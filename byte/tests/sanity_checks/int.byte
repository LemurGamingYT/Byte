fn main() -> int {
    int_a = 4
    int_b = 8
    assert(int_a + int_b == 12)
    assert(int_b - int_a == 4)
    assert(int_a * int_b == 32)
    assert(int_a / int_b == 0) // decimal answer = 0.5
    assert(int_b % int_a == 0)
    assert(int_a % int_b == 4)
    assert(!(int_a == int_b))
    assert(int_a != int_b)
    assert(int_b > int_a)
    assert(int_a < int_b)
    assert(int_a >= int_a)
    assert(int_b <= int_b)
    return 0
}
