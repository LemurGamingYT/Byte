class Vector2 {
    float x
    float y
}


fn length_squared(Vector2& vec) -> float {
    return vec.x * vec.x + vec.y * vec.y
}

fn length(Vector2& vec) -> float {
    return Math.sqrt(length_squared(vec))
}


fn main() -> int {
    vec = new Vector2(100.0, 100.0)
    assert(length(vec) == 141.421356)
    return 0
}
