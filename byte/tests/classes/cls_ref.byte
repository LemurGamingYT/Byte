class Vector2 {
    float x
    float y

    fn length_squared(Vector2& self) -> float {
        return self.x * self.x + self.y * self.y
    }

    fn length(Vector2& self) -> float {
        return Math.sqrt(self.length_squared())
    }
}


fn main() -> int {
    vec = new Vector2(100.0, 100.0)
    assert(vec.length() == 141.421356)
    return 0
}
