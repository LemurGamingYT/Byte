class Point {
    int x
    int y

    fn translate(mut Point& pt, Point& other) {
        pt.x += other.x
        pt.y += other.y
    }
}


fn main() -> int {
    mut pt = new Point(1, 2)
    assert(pt.x == 1)
    assert(pt.y == 2)

    other = new Point(2, 2)
    pt.translate(other)
    assert(pt.x == 3)
    assert(pt.y == 4)
    return 0
}
