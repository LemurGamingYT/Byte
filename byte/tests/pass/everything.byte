fn main() -> int {
    int_a = 4
    int_b = 8
    assert(int_a + int_b == 12)
    assert(int_b - int_a == 4)
    assert(int_a * int_b == 32)
    assert(int_a / int_b == 0) // decimal answer = 0.5
    assert(int_b % int_a == 0)
    assert(int_a % int_b == 4)
    assert(!(int_a == int_b))
    assert(int_a != int_b)
    assert(int_b > int_a)
    assert(int_a < int_b)
    assert(int_a >= int_a)
    assert(int_b <= int_b)

    assert(true && true)
    assert(!(false && false))
    assert(true || false)
    assert(!(false || false))

    assert(System.os == "Windows")
    System.pid
    System.sleep(1)

    hello = "Hello"
    world = "World"
    assert(hello + world == "HelloWorld")
    assert(hello + world != "Hello World")
    assert(hello.get(0) == "H")
    assert(world.get(2) == "r")
    assert(hello.get(-1) == "o")
    assert(world.get(-3) == "r")

    num_str = "42"
    assert(num_str.parse_int() == 42)
    return 0
}
